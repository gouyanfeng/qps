# docker compose 环境变量模板（本地开发用）。
# 复制为 .env 后按本机实际情况填写；.env 已被 .gitignore 忽略，不会提交。
# DB_PASSWORD 与 JWT_SECRET_KEY 为必填，缺失时 compose 会直接报错而不是用空值启动。

DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=QPS_CRM
DB_USER=sa
DB_PASSWORD=<your-db-password>
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>
JWT_ISSUER=QPS.API
JWT_AUDIENCE=QPS.Client
GATEWAY_PORT=8000
