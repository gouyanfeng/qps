# ============================================================================
# QPS 环境变量模板（本文件由 sync-deploy 工作流自动同步到 deploy 分支） —— 复制为 .env（服务器）或 .env.dev（本地）后填入真实值
# 各环境自行维护，本文件不入库、仓库不跟踪 .env/.env.dev
# 用法：docker compose --env-file .env up -d
# ----------------------------------------------------------------------------

# ------------------------------- 数据库 -------------------------------------
DB_HOST=                          # SQL Server 地址（本地容器内访问宿主机用 host.docker.internal）
DB_PORT=1433
DB_NAME=QPS
DB_USER=sa
DB_PASSWORD=                      # [必填] 数据库密码

# ------------------------------- 认证 ---------------------------------------
JWT_SECRET_KEY=

# ------------------------------- 文件存储 ------------------------------------
# provider: local（容器卷）| oss（阿里云 OSS）
STORAGE_PROVIDER=oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_OBJECT_ACL=public-read

# ------------------------------- 镜像仓库 ------------------------------------
REGISTRY=ghcr.io
IMAGE_OWNER=gouyanfeng
IMAGE_TAG=latest

# ------------------------------- 前端构建参数 --------------------------------
# 图片等静态文件访问域名（前端烧入镜像）
VITE_FILE_BASE_URL=https://qps-bucket.oss-cn-hangzhou.aliyuncs.com
# API 站点根（不含 /api 后缀）：两个前端共用，/api 前缀由各自项目代码拼接。
# 服务器填 http://<服务器IP>:5000；本地填 http://localhost:5000
VITE_API_BASE_URL=http://localhost:5000
