# ============================================================================
# QPS Docker Compose 部署配置
# ----------------------------------------------------------------------------
# <Guid("4B18E06B-FC6C-4CA5-A69D-A254F1CBFF56")>
# ============================================================================

# ------------------------------- 数据库 -------------------------------------
DB_HOST=rm-bp1u2i1n8b751369o.sqlserver.rds.aliyuncs.com
DB_PORT=1433
DB_NAME=QPS
DB_USER=sa
DB_PASSWORD=<your-db-password>                # [必填] SQL Server 密码

# ------------------------------- 认证 ---------------------------------------
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>  # [必填] 至少 32 字符

# ------------------------------- 文件存储 ------------------------------------
# local=写入容器 wwwroot（由数据卷 qps-uploads 持久化，并经网关 /uploads/ 直出）
# oss=上传到阿里云 OSS，需要同时填写下方 4 个 OSS 变量
STORAGE_PROVIDER=oss
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com  #ECS 的经典网络访问（内网） oss-cn-hangzhou-internal.aliyuncs.com
OSS_BUCKET=qps-bucket
OSS_ACCESS_KEY_ID=<your-access-key-id>        # [必填-oss] 建议仅授予该 Bucket 读写权限的 RAM 子账号
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>  # [必填-oss]
OSS_OBJECT_ACL=public-read

# ------------------------------- 网关与镜像 ----------------------------------
GATEWAY_PORT=80                               # 宿主机占用端口
REGISTRY=ghcr.io                              # 镜像仓库地址
IMAGE_OWNER=gouyanfeng                        # 镜像仓库所有者
IMAGE_TAG=latest                              # 镜像标签

# ------------------------------- 前端构建参数 --------------------------------

VITE_FILE_BASE_URL=https://qps-bucket.oss-cn-hangzhou.aliyuncs.com
VITE_API_BASE_URL=http://47.114.97.160/ap/
