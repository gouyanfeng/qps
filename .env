# docker compose 构建/部署变量模板（入库文件，只允许占位符）。
# CI 通过 docker compose --env-file .env 读取本文件完成镜像构建。
# 真实数据库密码与 JWT 密钥由部署环境注入，禁止把真实值写入本文件。
# DB_PASSWORD 与 JWT_SECRET_KEY 为 compose 必填变量（:?），缺失时 compose 直接报错而不是用空值启动。
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=QPS_CRM
DB_USER=sa
DB_PASSWORD=<your-db-password>
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>
GATEWAY_PORT=80
REGISTRY=ghcr.io
IMAGE_OWNER=gouyanfeng
IMAGE_TAG=latest

# --- 前端镜像构建参数（可选，留空/注释时用代码内置默认值） ---
# 图片等静态文件访问域名；缺省阿里云 OSS https://qps.oss-rg-china-mainland.aliyuncs.com
#VITE_FILE_BASE_URL=
# 移动端 API 基址；缺省空串（同源相对路径，由 gateway 转发）
#VITE_API_BASE_URL=
