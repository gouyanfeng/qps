# ============================================================================
# QPS Docker Compose 部署配置
# ----------------------------------------------------------------------------
# - 本文件入库，CI 通过 docker compose --env-file .env 读取完成镜像构建
# - 所有敏感值（数据库密码、JWT 密钥、OSS AK/SK）均为占位符，真实值放本地 .env.local（不入库）
# - 启动命令：docker compose --env-file .env --env-file .env.local up -d
# - 标注 [必填] 的变量（:?）缺失时 compose 直接报错，而不是用空值启动
# ============================================================================

# ------------------------------- 数据库 -------------------------------------
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=QPS_CRM
DB_USER=sa
DB_PASSWORD=<your-db-password>                # [必填] SQL Server 密码

# ------------------------------- 认证 ---------------------------------------
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>  # [必填] 至少 32 字符

# ------------------------------- 文件存储 ------------------------------------
# local=写入容器 wwwroot（由数据卷 qps-uploads 持久化，并经网关 /uploads/ 直出）
# oss=上传到阿里云 OSS，需要同时填写下方 4 个 OSS 变量
STORAGE_PROVIDER=oss
# Bucket 在杭州地域；-internal 版本只能在阿里云 VPC 内访问（ECS 可用，本地开发不可达）
# 因此这里统一用公网 endpoint：本地开发、容器、ECS 都可直连（ECS 出公网即可）
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=qps-bucket
OSS_ACCESS_KEY_ID=<your-access-key-id>        # 真实值写到服务器本地 .env.local，不入库
OSS_ACCESS_KEY_SECRET=<your-access-key-secret>
# 单个对象的 ACL：public-read（默认，私有 Bucket 下图片也能被浏览器读）/ private / default
OSS_OBJECT_ACL=public-read

# ------------------------------- 网关与镜像 ----------------------------------
GATEWAY_PORT=80                               # 宿主机占用端口
REGISTRY=ghcr.io                              # 镜像仓库地址
IMAGE_OWNER=gouyanfeng                        # 镜像仓库所有者
IMAGE_TAG=latest                              # 镜像标签

# ------------------------------- 前端构建参数 --------------------------------
# 图片等静态文件访问域名（admin/mobile 共用）
# 走 OSS 时必须与 Bucket 访问域名一致，格式 https://<bucket>.<endpoint> 或自定义 CDN 域名
# 走 local 时留空即可（图片走同源 /uploads/，由 gateway 转发到 api）
VITE_FILE_BASE_URL=https://qps-bucket.oss-cn-hangzhou.aliyuncs.com
# 移动端 API 基址；空串=同源相对路径，由 gateway 转发（镜像构建保持空串）
# 本地开发想直连服务器时，写到 .env.development.local（不入库），不要改这里
VITE_API_BASE_URL=
