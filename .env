# ============================================================================
# QPS Docker Compose 部署配置
# ----------------------------------------------------------------------------
# - 本文件为入库模板；CI 通过 docker compose --env-file .env 读取完成镜像构建
# - 真实数据库密码与 JWT 密钥由部署环境注入，禁止把真实值写入本文件
# - 标注 [必填] 的变量（:?）缺失时 compose 直接报错，而不是用空值启动
# ============================================================================

# ------------------------------- 数据库 -------------------------------------
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=QPS_CRM
DB_USER=sa
DB_PASSWORD=<your-db-password>                # [必填] SQL Server 密码

# ------------------------------- 认证 ---------------------------------------
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>  # [必填] 至少 32 字符

# ------------------------------- 网关与镜像 ----------------------------------
GATEWAY_PORT=80                               # 宿主机占用端口
REGISTRY=ghcr.io                              # 镜像仓库地址
IMAGE_OWNER=gouyanfeng                        # 镜像仓库所有者
IMAGE_TAG=latest                              # 镜像标签

# ------------------------------- 前端构建参数 --------------------------------
# 图片等静态文件访问域名（admin/mobile 共用）
VITE_FILE_BASE_URL=https://qps.oss-rg-china-mainland.aliyuncs.com
# 移动端 API 基址；空串=同源相对路径，由 gateway 转发
VITE_API_BASE_URL=47.114.97.160/api
