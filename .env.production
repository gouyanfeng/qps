# docker compose 构建/部署变量模板（入库文件，只允许占位符）。
# CI 通过 docker compose --env-file .env.production 读取本文件完成镜像构建。
# 真实数据库密码与 JWT 密钥由部署环境注入，禁止把真实值写入本文件。
# DB_PASSWORD 与 JWT_SECRET_KEY 为 compose 必填变量（:?），缺失时 compose 直接报错而不是用空值启动。
DB_HOST=host.docker.internal
DB_PORT=1433
DB_NAME=QPS_CRM
DB_USER=sa
DB_PASSWORD=<your-db-password>
JWT_SECRET_KEY=<your-jwt-secret-key-at-least-32-chars>
JWT_ISSUER=QPS.API
JWT_AUDIENCE=QPS.Client
GATEWAY_PORT=8000
REGISTRY=ghcr.io
IMAGE_OWNER=gouyanfeng
IMAGE_TAG=latest

